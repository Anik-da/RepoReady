# Backend storage and scan limits
REPOREADY_DATABASE_PATH=./backend/data/repoready.sqlite3
REPOREADY_MAX_UPLOAD_BYTES=52428800
REPOREADY_MAX_ARCHIVE_FILES=5000
REPOREADY_MAX_ARCHIVE_UNCOMPRESSED_BYTES=524288000
REPOREADY_MAX_SCAN_FILES=20000
REPOREADY_MAX_SCAN_FILE_BYTES=2097152
REPOREADY_GIT_TIMEOUT_SECONDS=120
REPOREADY_GIT_MAX_REPOSITORY_BYTES=524288000

# Frontend API base; Vite proxies /api to the local FastAPI server in development.
VITE_API_BASE_URL=/api
